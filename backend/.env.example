# Copia este archivo a ".env" y ajusta los valores

# Puerto del servidor (Render lo asigna automáticamente)
PORT=8080

# --- Base de datos ---
# Para Render (despliegue gratuito) usa SQLite:
DB_DIALECT=sqlite
SQLITE_STORAGE=./database.sqlite

# Para desarrollo local con MySQL:
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=1234
# DB_NAME=db
# DB_PORT=3306

# Clave secreta del JWT (¡cambiar en producción!)
JWT_SECRET=cambia-esto-por-una-clave-secreta-larga-y-segura

# Orígenes permitidos (separados por coma). En Render: la URL del frontend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
